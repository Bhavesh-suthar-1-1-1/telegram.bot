[Unit]
Description=Telegram Link Download Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/download-bot
ExecStart=/usr/bin/python3 /path/to/download-bot/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=ALLOWED_IDS=YOUR_TELEGRAM_USER_ID

[Install]
WantedBy=multi-user.target
